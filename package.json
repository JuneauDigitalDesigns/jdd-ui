{
  "name": "@jdd/ui",
  "version": "1.6.0",
  "description": "Shared design tokens, motion presets, icon registry and the LeadForm island used by the JDD catalog. Consumed by the console (authoring), the template, and every exported client repo.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./color": "./src/color.ts",
    "./palette": "./src/palette.ts",
    "./skins": "./src/skins.ts",
    "./motion": "./src/motion.ts",
    "./icons": "./src/icons.ts",
    "./img": "./src/img.ts",
    "./merge": "./src/merge.ts",
    "./lead-consent-text": "./src/lead-consent-text.ts",
    "./turnstile": "./src/turnstile.ts",
    "./LeadForm": "./src/LeadForm.tsx"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ./test/ts-transpile-register.mjs --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@phosphor-icons/react": ">=2",
    "framer-motion": ">=11",
    "react": ">=18"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "framer-motion": "^11.11.9",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "license": "UNLICENSED",
  "private": false
}
